# Copy to backend/.env for local development.
APP_NAME=AI Job Hunter API
APP_ENV=development
DATABASE_URL=sqlite:///./ai_job_hunter.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AUTO_SUBMIT_ENABLED=false
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b-instruct
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
# Add cloud-provider keys only to your local .env; never commit them.
RESUME_MAX_BYTES=2097152
# Optional. Leave false until you have verified your profile/answers and site permissions.
APPLICATION_BROWSER_PROFILE_DIR=data/browser-profile

# Optional global job aggregator credentials (keep private in local .env)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Optional broad web research (Brave Search API). Configure your own key; never commit backend/.env.
BRAVE_SEARCH_API_KEY=

# Optional local semantic ranking. If the embedding model is missing, matching falls back safely.
SEMANTIC_MATCHING_ENABLED=true
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Optional JobSpy multi-portal scraper. Disabled by default.
# Enable only after checking the terms for every portal you select.
JOBSPY_ENABLED=false
JOBSPY_SITES=linkedin,indeed,naukri,glassdoor,zip_recruiter,bayt,bdjobs,hellowork
JOBSPY_MAX_SEARCHES=6
JOBSPY_RESULTS_WANTED=12
